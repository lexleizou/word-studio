{
  "name": "word-studio",
  "version": "0.1.0",
  "description": "独立 Web 版 Word 工作台（设计稿 v2：模型驱动 + HTML 分页预览 + git 版本管理）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "for f in server/*.js web/*.js; do node --check \"$f\" || exit 1; done && echo 'syntax ok'"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.29.3",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
